{
    "name": "@actions-rs-plus/core",
    "version": "0.0.0",
    "private": false,
    "description": "Core functionality for the @actions-rs-plus repos",
    "bugs": {
        "url": "https://github.com/actions-rs-plus/core/issues"
    },
    "license": "MIT",
    "author": "actions-rs-plus",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/actions-rs-plus/core.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/core.js",
    "types": "dist/core.d.ts",
    "exports": {
        ".": {
            "types": "./dist/core.d.ts",
            "import": "./dist/core.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vite build",
        "watch": "vite build --watch",
        "lint": "oxlint",
        "lint:fix": "pnpm run lint --fix",
        "format": "oxfmt",
        "clean": "rm -rf ./dist/* && rm tsconfig.tsbuildinfo && pnpm run build",
        "test": "vitest --coverage.enabled=true",
        "deps:ci": "depcruise --config dependency-cruiser.config.ts --output-type err src",
        "deps:graph": "depcruise --config dependency-cruiser.config.ts --output-type dot src | dot -T svg > dependency-graph.svg",
        "deps:report": "depcruise --config dependency-cruiser.config.ts --output-type err-html --output-to dependency-report.html src",
        "postversion": "cp package.json pnpm-lock.yaml ..",
        "prepare": "husky"
    },
    "dependencies": {
        "@actions/cache": "^6.2.0",
        "@actions/core": "^3.0.1",
        "@actions/exec": "^3.0.0",
        "@actions/github": "^9.1.1",
        "@actions/http-client": "^4.0.1",
        "@actions/io": "^3.0.2",
        "@actions/tool-cache": "^4.0.0",
        "env-schema": "^8.0.0",
        "semver": "^7.8.5",
        "typebox": "^1.3.14"
    },
    "devDependencies": {
        "@codecov/vite-plugin": "2.0.1",
        "@microsoft/api-extractor": "7.59.0",
        "@types/node": "24.13.3",
        "@types/semver": "7.8.0",
        "@vitest/coverage-v8": "4.1.11",
        "@vitest/ui": "4.1.11",
        "dependency-cruiser": "18.2.0",
        "eslint-plugin-n": "18.3.0",
        "eslint-plugin-perfectionist": "5.11.0",
        "husky": "9.1.7",
        "lint-staged": "17.4.1",
        "oxfmt": "0.66.0",
        "oxlint": "1.80.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "6.0.3",
        "unplugin-dts": "1.1.0",
        "vite": "catalog:default",
        "vite-plugin-checker": "0.14.5",
        "vitest": "4.1.11"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "oxlint --no-error-on-unmatched-pattern --",
            "depcruise --config dependency-cruiser.config.ts --include-only ^src/ --validate --"
        ],
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ]
    },
    "engines": {
        "node": "24.20.0",
        "pnpm": "11.25.0"
    },
    "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
